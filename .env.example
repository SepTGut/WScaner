# Nomor WhatsApp Anda (Format: 628xxxxxxxxxx tanpa tanda '+' atau spasi)
ALLOWED_NUMBER=6281234567890

# Perintah WhatsApp
START_COMMAND=#start
STOP_COMMAND=#stop
STATUS_COMMAND=#status

# URL Web App Google Apps Script (dari Deploy > Web App berakhiran /exec)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# Secret Token untuk autentikasi ke Google Apps Script (Opsional / Disarankan)
GAS_SECRET_TOKEN=wscaner_secret_token_123

# URL Dokumen Spreadsheet Google Sheets
SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/.../edit

# Mesin OCR: windows (Native Lokal), groq (Groq VLM), gemini (Cloud LLM), drive (Google Drive OCR), auto (Hybrid)
OCR_ENGINE=auto

# Konfigurasi Groq Vision LLM (Opsional jika menggunakan groq / auto)
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# Konfigurasi Gemini Vision LLM (Opsional jika menggunakan gemini / auto)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

